<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <!-- The full C# runner for units 7+ (docs/code-plan.md decision A, Spike W):
       Roslyn compiles the learner's program inside .NET WebAssembly, and the
       program runs in the same runtime, in a worker with no network.
       Built by tools/build_cs_wasm.sh into assets/code/runtime/ (gitignored). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <WasmEnableWebcil>true</WasmEnableWebcil>
    <!-- trimmed, but every assembly a learner's program may use is rooted
         whole below (an untrimmed browser build does not load in 10.0.10) -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- real exception messages and reflection-based JSON, as on a desktop -->
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <RunAOTCompilation>false</RunAOTCompilation>
    <CompressionEnabled>false</CompressionEnabled>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <!-- the reference assemblies Roslyn compiles against (from the SDK's ref pack) -->
  <ItemGroup>
