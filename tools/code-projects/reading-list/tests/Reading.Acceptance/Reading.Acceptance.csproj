<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kurenai's acceptance tests: your window, run headless (no screen). Protected:
       the validator checks these files have not changed. Your own tests go in tests/Reading.Tests. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xunit v3 asks every async call for TestContext.Current.CancellationToken: not this track's lesson -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Reading/Reading.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Avalonia.Headless.XUnit" />
    <Using Include="Avalonia.LogicalTree" />
  </ItemGroup>
</Project>
