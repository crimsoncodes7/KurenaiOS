<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- The Planner's web API: ASP.NET Core minimal APIs over EF Core and SQLite. Yours to build. -->
  <PropertyGroup>
    <UserSecretsId>kurenai-planner-api</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <!-- the native SQLite it uses, pinned past a known advisory in 2.1.11 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- for `dotnet ef migrations add`; not shipped with the app -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
